<?xml version="1.0" encoding="utf-8"?>
<!--
  HCE service descriptor.

  category="other"  -> this is NOT a payment service.
  AID D2760000850101 -> the standard Type-4 NDEF Tag application, so external readers
                        that expect an NDEF tag will SELECT this application.
  requireDeviceUnlock="false" -> respond like a real card even while the phone is locked.

  NOTE: for a fully custom system you control, replace the AID below with your own
  proprietary AID (e.g. F0..). The Type-4 NDEF AID is used here to mimic NDEF cards.
-->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/hce_service_description"
    android:requireDeviceUnlock="false">
    <aid-group
        android:description="@string/hce_aid_group_description"
        android:category="other">
        <aid-filter android:name="D2760000850101" />
    </aid-group>
</host-apdu-service>
