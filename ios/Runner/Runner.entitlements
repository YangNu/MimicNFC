<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Near Field Communication Tag Reading capability.
	  "TAG" enables ISO 7816 APDU exchange (NFCTagReaderSession / NFCISO7816Tag),
	  which is what the capture side needs.

	  NOTE: card emulation (com.apple.developer.nfc.hce) is intentionally NOT here.
	  Apple only grants HCE to approved partners, so iOS supports capture, not replay.
	-->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
